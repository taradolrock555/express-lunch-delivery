# Server
PORT=3000

# Comma-separated allowed frontend origins. Add the deployed frontend URL when hosting separately.
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# SQLite (ค่าเริ่มต้น) — ไม่ต้องติดตั้งฐานข้อมูลเพิ่ม
SQLITE_FILE=./data/lunch-delivery.db

# ร้านและราคา (ค่าเริ่มต้นตรงกับโจทย์ Project.pdf)
SHOP_NAME=ข้าวกล่องเดลิเวอรี ส่งด่วนมือเที่ยง
SHOP_ADDRESS=ร้านข้าวกล่องเดลิเวอรี ใกล้มหาวิทยาลัยมหาสารคาม ตำบลขามเรียง อำเภอกันทรวิชัย จังหวัดมหาสารคาม
SHOP_LATITUDE=16.2452
SHOP_LONGITUDE=103.2501
SALE_PRICE_PER_BOX=65
FOOD_COST_PER_BOX=40
RIDER_FEE_PER_TRIP=15
RIDER_COST_PER_KM_PER_BOX=2
RIDER_SPEED_KMH=30
DEPARTURE_TIME=11:30
DEADLINE_TIME=12:30
MAX_BOXES_PER_ORDER=3
MAX_ORDERS_PER_RIDER=3

# งบประมาณค่าส่งต่อวัน และกำไรสุทธิขั้นต่ำที่ร้านต้องการ
DAILY_DELIVERY_BUDGET=500
TARGET_PROFIT=300

# OSRM (ใช้บริการสาธารณะ; ถ้าไม่ตอบภายในเวลาจะ fallback เป็น Haversine)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=3000
